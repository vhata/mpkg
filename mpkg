#!/usr/bin/env python3
"""Manage the metapackages stored beside this executable."""

import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
DEPENDENCY = r"[a-zA-Z0-9_+][a-zA-Z0-9@._+:<>=~-]*"


def run(*args, cwd=ROOT, capture=False, check=True, **kwargs):
    return subprocess.run(args, cwd=cwd, text=True, check=check,
                          stdout=subprocess.PIPE if capture else None, **kwargs)


def package_name(value):
    if not re.fullmatch(r"[a-z0-9][a-z0-9_+-]*", value):
        raise ValueError(f"Invalid package name: {value}")
    return "vhata-" + value.removeprefix("vhata-")


def build_path(name):
    return ROOT / name / "PKGBUILD"


def require_package(name):
    if not build_path(name).is_file():
        raise ValueError(f"Unknown metapackage: {name}")


def require_yay():
    if shutil.which("yay") is None:
        raise ValueError("yay is required to create, update, or refresh metapackages. "
                         "Install yay and retry. Listing and inspection are still available.")


def install(name, force=False):
    # Local PKGBUILDs are not AUR checkouts: yay -B may try to Git-merge them.
    fields = metadata(name)
    deps = dependencies(fields)
    if deps:
        missing = run("pacman", "-T", *deps, capture=True, check=False)
        if missing.returncode not in (0, 127):
            raise subprocess.CalledProcessError(missing.returncode, missing.args)
        targets = missing.stdout.splitlines()
        if targets:
            run("yay", "-S", "--needed", "--asdeps", "--", *targets)
    run("makepkg", "-sif" if force else "-si", cwd=ROOT / name)


def metadata(name):
    output = run("makepkg", "--printsrcinfo", cwd=ROOT / name, capture=True).stdout
    fields = {}
    for line in output.splitlines():
        key, separator, value = line.strip().partition(" = ")
        if separator:
            fields.setdefault(key, []).append(value)
    return fields


def dependencies(fields, include_arch=False):
    """Select active requirements, or every architecture for inspection."""
    active_arch = f"depends_{os.uname().machine}"
    return [value for key, values in fields.items()
            if key in ("depends", active_arch) or (include_arch and key.startswith("depends_"))
            for value in values]


def inspect_packages(mode, names):
    names = [package_name(name) for name in names]
    if not names:
        raise ValueError("Supply at least one metapackage name.")
    for name in names:
        require_package(name)
    for index, name in enumerate(names):
        fields = metadata(name)
        description = fields.get("pkgdesc", [""])[-1]
        deps = dependencies(fields, include_arch=True)
        if mode == "--info" or len(names) > 1:
            if index:
                print()
            print(f"{name}:")
        if mode == "--info":
            print(f"  Description: {description}\n  Dependencies:")
            for dep in deps:
                print(f"    {dep}")
        elif mode == "--description":
            print(description)
        else:
            for dep in deps:
                print(dep)


def installed_providers(output, deps):
    records = []
    for block in output.split("\n\n"):
        fields = {}
        key = None
        for line in block.splitlines():
            match = re.match(r"^([^ :][^:]*?)\s*:\s*(.*)$", line)
            if match:
                key = match[1].strip()
                fields[key] = match[2]
            elif key and line.startswith(" "):
                fields[key] += " " + line.strip()
        if "Name" in fields:
            records.append(fields)
    selected = set()
    for dep in deps:
        requirement = re.fullmatch(r"([^<>=]+)(?:(>=|<=|=|>|<)([^<>=]+))?", dep)
        if requirement is None:
            raise ValueError(f"Invalid dependency: {dep}")
        name, operator, wanted = requirement.groups()

        def satisfies(version):
            if operator is None:
                return True
            if not version:
                return False
            # Use pacman's comparator, including epochs and optional pkgrel.
            comparison = int(run("vercmp", version, wanted, capture=True).stdout.strip())
            return {"=": comparison == 0, ">": comparison > 0, "<": comparison < 0,
                    ">=": comparison >= 0, "<=": comparison <= 0}[operator]

        providers = [r["Name"] for r in records
                     if r["Name"] == name and satisfies(r.get("Version"))]
        if not providers:
            for record in records:
                provides = record.get("Provides", "")
                if provides == "None":
                    continue
                for provided in provides.split():
                    provided_name, _, version = provided.partition("=")
                    if provided_name == name and satisfies(version):
                        providers.append(record["Name"])
                        break
        if not providers:
            raise ValueError(f"Cannot find installed provider for {dep}")
        selected.update(providers)
    return sorted(selected)


def mark_dependencies(deps):
    if deps:
        info = run("pacman", "-Qi", capture=True, env=dict(os.environ, LC_ALL="C")).stdout
        run("sudo", "pacman", "-D", "--asdeps", *installed_providers(info, deps))


def refresh(name):
    require_package(name)
    require_yay()
    fields = metadata(name)
    if not fields.get("pkgver") or not fields.get("pkgrel"):
        raise ValueError("Cannot refresh: missing version metadata.")
    version = f"{fields['pkgver'][-1]}-{fields['pkgrel'][-1]}"
    epoch = fields.get("epoch", ["0"])[-1]
    if epoch != "0":
        version = f"{epoch}:{version}"
    deps = dependencies(fields)
    installed = run("pacman", "-Q", name, capture=True, check=False, stderr=subprocess.DEVNULL)
    need_build = installed.returncode != 0 or installed.stdout.strip() != f"{name} {version}"
    if deps:
        missing = run("pacman", "-T", *deps, capture=True, check=False)
        need_build = need_build or missing.returncode != 0
    if need_build:
        install(name, force=True)
    else:
        print(f"{name} is up to date ({version}).")
    mark_dependencies(deps)


def literal_tokens(text):
    """Locate words without evaluating shell code; reject unclear boundaries."""
    tokens = []
    position = 0
    operators = "();&|<>"
    while position < len(text):
        char = text[position]
        if char in " \t":
            position += 1
            continue
        if char == "#":
            end = text.find("\n", position)
            position = len(text) if end < 0 else end
            continue
        start = position
        if char == "\n" or char in operators:
            if char in "<>":
                raise ValueError("Cannot edit PKGBUILD with shell redirections or here-documents.")
            position += 1
        else:
            while position < len(text):
                char = text[position]
                if char in " \t\n" + operators:
                    break
                if char in "\"'":
                    quote = char
                    position += 1
                    while position < len(text) and text[position] != quote:
                        if quote == '"' and text[position] in "$`\\":
                            raise ValueError("Cannot edit PKGBUILD with shell expansions or escapes.")
                        position += 1
                    if position == len(text):
                        raise ValueError("Cannot edit PKGBUILD with an unterminated quote.")
                elif char in "$`\\":
                    raise ValueError("Cannot edit PKGBUILD with shell expansions or escapes.")
                position += 1
        tokens.append((text[start:position], start, position))
    return tokens


def literal_assignments(text):
    """Read simple top-level assignments, keeping their original source spans.

    This is deliberately a restricted editor, not a Bash interpreter. Reject
    compound top-level commands and ambiguous function bodies rather than
    guessing which assignments execute. Quoted words and comments are opaque.
    """
    tokens = literal_tokens(text)
    fields = {}
    position = 0
    while position < len(tokens):
        word, start, end = tokens[position]
        if word == "\n":
            position += 1
            continue
        assignment = re.fullmatch(r"([a-zA-Z_][a-zA-Z0-9_]*)=(.*)", word, re.S)
        if assignment:
            name, value = assignment.groups()
            position += 1
            if value == "" and position < len(tokens) and tokens[position][0] == "(":
                value = []
                position += 1
                while position < len(tokens) and tokens[position][0] != ")":
                    item = tokens[position][0]
                    if item in ("(", ";", "&", "|"):
                        raise ValueError("Expected a literal PKGBUILD array.")
                    if item != "\n":
                        value.append(item)
                    position += 1
                if position == len(tokens):
                    raise ValueError("Expected a closing parenthesis for the literal array.")
                end = tokens[position][2]
                position += 1
            fields.setdefault(name, []).append((slice(start, end), value))
        elif (re.fullmatch(r"[a-zA-Z_][a-zA-Z0-9_]*", word)
              and [token[0] for token in tokens[position + 1:position + 3]] == ["(", ")"]):
            position += 3
            while position < len(tokens) and tokens[position][0] == "\n":
                position += 1
            if position == len(tokens) or tokens[position][0] != "{":
                raise ValueError("Expected a brace-delimited package function.")
            # Ordinary metapackage functions contain simple commands. Without
            # compound shell syntax, a standalone closing brace at a command
            # boundary unambiguously ends the function; quoted braces do not.
            position += 1
            command_start = True
            while position < len(tokens):
                item = tokens[position][0]
                if item == "}":
                    if not command_start:
                        raise ValueError("Cannot edit PKGBUILD with ambiguous function braces.")
                    position += 1
                    break
                if item in {"{", "if", "then", "else", "elif", "fi", "case", "esac",
                            "for", "select", "while", "until", "do", "done", "function"}:
                    raise ValueError("Cannot edit PKGBUILD with compound function syntax.")
                command_start = item in {"\n", ";", "&", "|"}
                position += 1
            else:
                raise ValueError("Expected a closing brace for the package function.")
        else:
            raise ValueError("Cannot edit PKGBUILD: expected literal assignments or simple functions.")
        if position < len(tokens) and tokens[position][0] != "\n":
            raise ValueError("Cannot edit PKGBUILD: expected one assignment or function per line.")
    return fields


def literal_dependencies(text, fields=None):
    if fields is None:
        fields = literal_assignments(text)
    blocks = fields.get("depends", [])
    if len(blocks) != 1 or not isinstance(blocks[0][1], list):
        raise ValueError("Expected one literal depends array.")
    block, words = blocks[0]
    deps = {shlex.split(word, comments=False)[0] for word in words}
    validate_dependencies(deps)
    return block, deps


def validate_pkgbuild(text):
    # Syntax checking must not source startup files or execute package code.
    env = {key: value for key, value in os.environ.items() if key not in {"BASH_ENV", "ENV"}}
    result = run("bash", "--noprofile", "--norc", "-n", input=text, env=env,
                 capture=True, check=False, stderr=subprocess.PIPE)
    if result.returncode:
        raise ValueError("Invalid PKGBUILD syntax: " + result.stderr.strip())


def validate_dependencies(deps):
    for dep in deps:
        if not re.fullmatch(DEPENDENCY, dep):
            raise ValueError(f"Invalid dependency: {dep}")


def dependency_array(deps):
    return "depends=(\n" + "".join(f"  {shlex.quote(dep)}\n" for dep in sorted(deps)) + ")"


def commit_message(name, old, new, description=None):
    if old is None:
        return f"[pkgs] Create {name}: {description}\n\nDependencies: {' '.join(sorted(new))}"
    changes = []
    if new - old:
        changes.append("add " + ", ".join(sorted(new - old)))
    if old - new:
        changes.append("remove " + ", ".join(sorted(old - new)))
    if description is not None:
        changes.append("set description to " + description)
    return f"[pkgs] Update {name}: " + ("; ".join(changes) or "bump release")


def update(name, args):
    require_yay()
    path = build_path(name)
    original = None
    if path.exists():
        with path.open(newline="") as source:
            original = source.read()
    release = 1
    old_deps = None
    if original is not None:
        fields = literal_assignments(original)
        releases = fields.get("pkgrel", [])
        if (len(releases) != 1 or not isinstance(releases[0][1], str)
                or not re.fullmatch(r"[0-9]+", releases[0][1])):
            raise ValueError("Cannot increment pkgrel: expected one integer assignment.")
        release_block, previous_release = releases[0]
        release = int(previous_release) + 1
        block, old_deps = literal_dependencies(original, fields)
        validate_pkgbuild(original)
    description = None
    if args[0].startswith(("+", "-")):
        if original is None:
            raise ValueError(f"Cannot edit: {name}/PKGBUILD does not exist.")
        deps = old_deps.copy()
        for change in args:
            if len(change) < 2 or change[0] not in "+-":
                raise ValueError("Each edit must be +PACKAGE or -PACKAGE.")
            validate_dependencies([change[1:]])
            if change[0] == "+":
                deps.add(change[1:])
            else:
                deps.discard(change[1:])
        updated = original
        replacements = [(block, dependency_array(deps)), (release_block, f"pkgrel={release}")]
        for span, replacement in sorted(replacements, key=lambda item: item[0].start, reverse=True):
            updated = updated[:span.start] + replacement + updated[span.stop:]
    else:
        if len(args) < 2:
            raise ValueError("Supply a description and at least one dependency.")
        description, *requested = args
        validate_dependencies(requested)
        deps = set(requested)
        updated = (f"pkgname={name}\npkgver=1\npkgrel={release}\n"
                   f"pkgdesc={shlex.quote(description)}\narch=('any')\n\n"
                   f"{dependency_array(deps)}\n\npackage() {{\n  :\n}}\n")
    validate_pkgbuild(updated)
    path.parent.mkdir(exist_ok=True)
    path.write_text(updated)
    try:
        install(name)
        mark_dependencies(deps)
    except (subprocess.CalledProcessError, OSError, ValueError):
        print(f"Update failed; {path} retains the edits for correction or retry. No commit created.",
              file=sys.stderr)
        raise
    message = commit_message(name, old_deps, deps, description)
    # --only excludes unrelated staged files, including for newly created packages.
    run("git", "add", "--", str(path.relative_to(ROOT)))
    run("git", "commit", "--only", "-m", message, "--", str(path.relative_to(ROOT)))


def usage():
    print(f"""Usage: {sys.argv[0]} METAPKG_NAME DESC PKG [ PKG .. ]
       {sys.argv[0]} METAPKG_NAME +PKG|-PKG [ +PKG|-PKG .. ]
       {sys.argv[0]} METAPKG_NAME --refresh
       {sys.argv[0]} --list
       {sys.argv[0]} --info|--description|--depends METAPKG_NAME [ METAPKG_NAME .. ]""")


def main(args):
    if args and args[0] in ("--help", "-h"):
        usage()
    elif args == ["--list"]:
        for path in sorted(ROOT.glob("vhata-*/PKGBUILD")):
            if path.is_file():
                print(path.parent.name)
    elif args and args[0] in ("--info", "--description", "--depends"):
        inspect_packages(args[0], args[1:])
    elif len(args) >= 2:
        name = package_name(args[0])
        if args[1] == "--refresh":
            if len(args) != 2:
                raise ValueError("Refresh takes no additional arguments.")
            refresh(name)
        else:
            update(name, args[1:])
    else:
        usage()
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except subprocess.CalledProcessError as error:
        print(f"Command failed: {shlex.join(error.cmd)}", file=sys.stderr)
        sys.exit(error.returncode if error.returncode > 0 else 1)
    except (ValueError, OSError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
