#!/usr/bin/env python3
"""Manage the metapackages stored beside this executable."""

import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent
DEPENDENCY = r"[a-zA-Z0-9_+][a-zA-Z0-9@._+:<>=~-]*"


def run(*args, cwd=ROOT, capture=False, check=True, **kwargs):
    return subprocess.run(args, cwd=cwd, text=True, check=check,
                          stdout=subprocess.PIPE if capture else None, **kwargs)


def package_name(value):
    if not re.fullmatch(r"[a-z0-9][a-z0-9_+-]*", value):
        raise ValueError(f"Invalid package name: {value}")
    return "vhata-" + value.removeprefix("vhata-")


def build_path(name):
    return ROOT / name / "PKGBUILD"


def require_package(name):
    if not build_path(name).is_file():
        raise ValueError(f"Unknown metapackage: {name}")


def require_yay():
    if shutil.which("yay") is None:
        raise ValueError("yay is required to create, update, or refresh metapackages. "
                         "Install yay and retry. Listing and inspection are still available.")


def install(name, force=False):
    args = ["yay", "-Bi", str(ROOT / name)]
    if force:
        args.append("--mflags=--force")
    run(*args)


def metadata(name):
    output = run("makepkg", "--printsrcinfo", cwd=ROOT / name, capture=True).stdout
    fields = {}
    for line in output.splitlines():
        key, separator, value = line.strip().partition(" = ")
        if separator:
            fields.setdefault(key, []).append(value)
    return fields


def dependencies(fields, include_arch=False):
    return [value for key, values in fields.items()
            if key == "depends" or (include_arch and key.startswith("depends_"))
            for value in values]


def inspect_packages(mode, names):
    names = [package_name(name) for name in names]
    if not names:
        raise ValueError("Supply at least one metapackage name.")
    for name in names:
        require_package(name)
    for index, name in enumerate(names):
        fields = metadata(name)
        description = fields.get("pkgdesc", [""])[-1]
        deps = dependencies(fields, include_arch=True)
        if mode == "--info" or len(names) > 1:
            if index:
                print()
            print(f"{name}:")
        if mode == "--info":
            print(f"  Description: {description}\n  Dependencies:")
            for dep in deps:
                print(f"    {dep}")
        elif mode == "--description":
            print(description)
        else:
            for dep in deps:
                print(dep)


def installed_providers(output, deps):
    records = []
    for block in output.split("\n\n"):
        fields = {}
        key = None
        for line in block.splitlines():
            match = re.match(r"^([^ :][^:]*?)\s*:\s*(.*)$", line)
            if match:
                key = match[1].strip()
                fields[key] = match[2]
            elif key and line.startswith(" "):
                fields[key] += " " + line.strip()
        if "Name" in fields:
            records.append(fields)
    selected = set()
    for dep in deps:
        name = re.split(r"[<>=]", dep, maxsplit=1)[0]
        providers = [r["Name"] for r in records if r["Name"] == name]
        providers = providers or [r["Name"] for r in records if name in
                                 [p.split("=", 1)[0] for p in r.get("Provides", "").split()]]
        if not providers:
            raise ValueError(f"Cannot find installed provider for {dep}")
        selected.update(providers)
    return sorted(selected)


def refresh(name):
    require_package(name)
    require_yay()
    fields = metadata(name)
    if not fields.get("pkgver") or not fields.get("pkgrel"):
        raise ValueError("Cannot refresh: missing version metadata.")
    version = f"{fields['pkgver'][-1]}-{fields['pkgrel'][-1]}"
    epoch = fields.get("epoch", ["0"])[-1]
    if epoch != "0":
        version = f"{epoch}:{version}"
    deps = dependencies(fields)
    installed = run("pacman", "-Q", name, capture=True, check=False, stderr=subprocess.DEVNULL)
    need_build = installed.returncode != 0 or installed.stdout.strip() != f"{name} {version}"
    if deps:
        missing = run("pacman", "-T", *deps, capture=True, check=False)
        need_build = need_build or missing.returncode != 0
    if need_build:
        install(name, force=True)
    else:
        print(f"{name} is up to date ({version}).")
    if deps:
        info = run("pacman", "-Qi", capture=True, env=dict(os.environ, LC_ALL="C")).stdout
        run("sudo", "pacman", "-D", "--asdeps", *installed_providers(info, deps))


def literal_dependencies(text):
    blocks = list(re.finditer(r"^depends=\((.*?)\)", text, re.M | re.S))
    if len(blocks) != 1:
        raise ValueError("Expected one literal depends array.")
    block = blocks[0]
    if any(char in block[1] for char in "$`\\"):
        raise ValueError("Depends array must contain literal package names.")
    deps = set(shlex.split(block[1], comments=True))
    validate_dependencies(deps)
    return block, deps


def validate_dependencies(deps):
    for dep in deps:
        if not re.fullmatch(DEPENDENCY, dep):
            raise ValueError(f"Invalid dependency: {dep}")


def dependency_array(deps):
    return "depends=(\n" + "".join(f"  {shlex.quote(dep)}\n" for dep in sorted(deps)) + ")"


def commit_message(name, old, new, description=None):
    if old is None:
        return f"[pkgs] Create {name}: {description}\n\nDependencies: {' '.join(sorted(new))}"
    changes = []
    if new - old:
        changes.append("add " + ", ".join(sorted(new - old)))
    if old - new:
        changes.append("remove " + ", ".join(sorted(old - new)))
    if description is not None:
        changes.append("set description to " + description)
    return f"[pkgs] Update {name}: " + ("; ".join(changes) or "bump release")


def update(name, args):
    require_yay()
    path = build_path(name)
    original = path.read_text() if path.exists() else None
    release = 1
    old_deps = None
    if original is not None:
        releases = re.findall(r"^pkgrel=([0-9]+)$", original, re.M)
        if len(releases) != 1:
            raise ValueError("Cannot increment pkgrel: expected one integer assignment.")
        release = int(releases[0]) + 1
        _, old_deps = literal_dependencies(original)
    description = None
    if args[0].startswith(("+", "-")):
        if original is None:
            raise ValueError(f"Cannot edit: {name}/PKGBUILD does not exist.")
        block, deps = literal_dependencies(original)
        for change in args:
            if len(change) < 2 or change[0] not in "+-":
                raise ValueError("Each edit must be +PACKAGE or -PACKAGE.")
            validate_dependencies([change[1:]])
            if change[0] == "+":
                deps.add(change[1:])
            else:
                deps.discard(change[1:])
        updated = original[:block.start()] + dependency_array(deps) + original[block.end():]
        updated = re.sub(r"^pkgrel=[0-9]+$", f"pkgrel={release}", updated, count=1, flags=re.M)
    else:
        if len(args) < 2:
            raise ValueError("Supply a description and at least one dependency.")
        description, *requested = args
        validate_dependencies(requested)
        deps = set(requested)
        updated = (f"pkgname={name}\npkgver=1\npkgrel={release}\n"
                   f"pkgdesc={shlex.quote(description)}\narch=('any')\n\n"
                   f"{dependency_array(deps)}\n\npackage() {{\n  :\n}}\n")
    path.parent.mkdir(exist_ok=True)
    path.write_text(updated)
    try:
        install(name)
        if deps:
            run("sudo", "pacman", "-D", "--asdeps", *sorted(deps))
    except (subprocess.CalledProcessError, OSError):
        print(f"Update failed; {path} retains the edits for correction or retry. No commit created.",
              file=sys.stderr)
        raise
    message = commit_message(name, old_deps, deps, description)
    # --only excludes unrelated staged files, including for newly created packages.
    run("git", "add", "--", str(path.relative_to(ROOT)))
    run("git", "commit", "--only", "-m", message, "--", str(path.relative_to(ROOT)))


def usage():
    print(f"""Usage: {sys.argv[0]} METAPKG_NAME DESC PKG [ PKG .. ]
       {sys.argv[0]} METAPKG_NAME +PKG|-PKG [ +PKG|-PKG .. ]
       {sys.argv[0]} METAPKG_NAME --refresh
       {sys.argv[0]} --list
       {sys.argv[0]} --info|--description|--depends METAPKG_NAME [ METAPKG_NAME .. ]""")


def main(args):
    if args and args[0] in ("--help", "-h"):
        usage()
    elif args == ["--list"]:
        for path in sorted(ROOT.glob("vhata-*/PKGBUILD")):
            if path.is_file():
                print(path.parent.name)
    elif args and args[0] in ("--info", "--description", "--depends"):
        inspect_packages(args[0], args[1:])
    elif len(args) >= 2:
        name = package_name(args[0])
        if args[1] == "--refresh":
            if len(args) != 2:
                raise ValueError("Refresh takes no additional arguments.")
            refresh(name)
        else:
            update(name, args[1:])
    else:
        usage()
        return 1
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except subprocess.CalledProcessError as error:
        print(f"Command failed: {shlex.join(error.cmd)}", file=sys.stderr)
        sys.exit(error.returncode if error.returncode > 0 else 1)
    except (ValueError, OSError) as error:
        print(error, file=sys.stderr)
        sys.exit(1)
