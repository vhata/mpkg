pkgname=viminumrc
pkgver=1
pkgrel=1
pkgdesc='Shared Vim configuration and system-wide login environment'
arch=('any')
depends=('vim')
backup=(
  'usr/local/etc/vimrc/vimrc'
  'etc/profile.d/viminumrc.sh'
)
source=(
  'vimrc'
  'README.vimrc'
  'surround.vim'
  'repeat.vim'
  'bundle-README.md'
  'LICENSE.txt'
  'viminumrc.sh'
)

package() {
  install -Dm644 "$srcdir/vimrc" "$pkgdir/usr/local/etc/vimrc/vimrc"
  install -Dm644 "$srcdir/README.vimrc" "$pkgdir/usr/local/etc/vimrc/README.md"
  install -Dm644 "$srcdir/surround.vim" \
    "$pkgdir/usr/local/etc/vimrc/bundle/surround.vim"
  install -Dm644 "$srcdir/repeat.vim" \
    "$pkgdir/usr/local/etc/vimrc/bundle/autoload/repeat.vim"
  install -Dm644 "$srcdir/bundle-README.md" \
    "$pkgdir/usr/local/etc/vimrc/bundle/README.md"
  install -Dm644 "$srcdir/LICENSE.txt" \
    "$pkgdir/usr/local/etc/vimrc/bundle/LICENSE.txt"
  install -Dm644 "$srcdir/viminumrc.sh" "$pkgdir/etc/profile.d/viminumrc.sh"
}
sha256sums=('a197dbdf23c1c11c33d1ee585ba1d618fe96cb83bba2a1d59d89e248a21e928b'
